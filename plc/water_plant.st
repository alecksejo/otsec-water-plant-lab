PROGRAM WaterPlant
  VAR
    PUMP_RUN AT %QX0.0 : BOOL;
    TANK_LEVEL AT %QW0 : INT;
    MANUAL_OVERRIDE AT %QX0.1 : BOOL;
  END_VAR

  IF NOT MANUAL_OVERRIDE THEN
    IF TANK_LEVEL <= 20 THEN
      PUMP_RUN := TRUE;
    ELSIF TANK_LEVEL >= 80 THEN
      PUMP_RUN := FALSE;
    END_IF;
  END_IF;

  IF PUMP_RUN AND (TANK_LEVEL < 100) THEN
    TANK_LEVEL := TANK_LEVEL + 1;
  ELSIF (NOT PUMP_RUN) AND (TANK_LEVEL > 0) THEN
    TANK_LEVEL := TANK_LEVEL - 1;
  END_IF;
END_PROGRAM

CONFIGURATION Config0
  RESOURCE Res0 ON PLC
    TASK Task0(INTERVAL := T#100ms, PRIORITY := 0);
    PROGRAM Inst0 WITH Task0 : WaterPlant;
  END_RESOURCE
END_CONFIGURATION
