[
    {
        "id": "water_hmi_tab",
        "type": "tab",
        "label": "Water Plant HMI",
        "disabled": false,
        "info": ""
    },
    {
        "id": "read_tank",
        "type": "modbus-read",
        "z": "water_hmi_tab",
        "name": "Read Tank Level",
        "topic": "tank",
        "showStatusActivities": true,
        "logIOActivities": false,
        "showErrors": true,
        "unitid": "1",
        "dataType": "HoldingRegister",
        "adr": "0",
        "quantity": "1",
        "rate": "500",
        "rateUnit": "ms",
        "delayOnStart": false,
        "startDelayTime": "",
        "server": "openplc_modbus",
        "useIOFile": false,
        "ioFile": "",
        "useIOForPayload": false,
        "x": 150,
        "y": 120,
        "wires": [
            [
                "process_tank"
            ],
            []
        ]
    },
    {
        "id": "process_tank",
        "type": "function",
        "z": "water_hmi_tab",
        "name": "Process Tank Level",
        "func": "let level = Number(msg.payload[0]);\n\nif (!Number.isFinite(level)) return null;\n\nlevel = Math.max(0, Math.min(100, level));\n\nflow.set('tankLevel', level);\n\nmsg.payload = level;\nmsg.topic = 'Tank Level';\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 120,
        "wires": [
            [
                "tank_visual",
                "tank_chart"
            ]
        ]
    },
    {
        "id": "read_pump",
        "type": "modbus-read",
        "z": "water_hmi_tab",
        "name": "Read Pump Status",
        "topic": "pump",
        "showStatusActivities": true,
        "logIOActivities": false,
        "showErrors": true,
        "unitid": "1",
        "dataType": "Coil",
        "adr": "0",
        "quantity": "1",
        "rate": "500",
        "rateUnit": "ms",
        "delayOnStart": false,
        "startDelayTime": "",
        "server": "openplc_modbus",
        "useIOFile": false,
        "ioFile": "",
        "useIOForPayload": false,
        "x": 150,
        "y": 200,
        "wires": [
            [
                "process_pump"
            ],
            []
        ]
    },
    {
        "id": "process_pump",
        "type": "function",
        "z": "water_hmi_tab",
        "name": "Process Pump Status",
        "func": "let value = msg.payload[0];\nlet running = (value === true || value === 1 || value === '1');\n\nflow.set('pumpRunning', running);\n\nmsg.payload = {\n    level: flow.get('tankLevel') || 0,\n    pump: running\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 200,
        "wires": [
            [
                "tank_visual"
            ]
        ]
    },
    {
        "id": "tank_visual",
        "type": "ui_template",
        "z": "water_hmi_tab",
        "group": "water_group",
        "name": "Water Tank Display",
        "order": 1,
        "width": 6,
        "height": 7,
        "format": "<div style=\"font-family:Arial,sans-serif;text-align:center;padding:12px;\">\n\n<h2 style=\"margin:0 0 18px 0;\">Water Plant</h2>\n\n<div style=\"position:relative;width:150px;height:210px;border:4px solid #555;border-radius:5px;margin:auto;overflow:hidden;background:#eee;\">\n\n<div style=\"position:absolute;bottom:0;width:100%;height:{{(msg.payload.level !== undefined ? msg.payload.level : msg.payload)}}%;background:#2196F3;transition:height 0.4s ease;\"></div>\n\n<div style=\"position:absolute;top:0;left:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:bold;\">\n{{msg.payload.level !== undefined ? msg.payload.level : msg.payload}}%\n</div>\n\n</div>\n\n<div style=\"width:16px;height:25px;background:#777;margin:auto;\"></div>\n\n<div style=\"margin-top:8px;font-size:15px;\">Water Pump</div>\n\n<div ng-if=\"msg.payload.pump === true\" style=\"font-size:20px;font-weight:bold;color:#2e7d32;margin-top:4px;\">\nRUNNING\n</div>\n\n<div ng-if=\"msg.payload.pump === false\" style=\"font-size:20px;font-weight:bold;color:#c62828;margin-top:4px;\">\nSTOPPED\n</div>\n\n<div ng-if=\"msg.payload.pump === undefined\" style=\"font-size:16px;color:#666;margin-top:4px;\">\nWaiting for pump status...\n</div>\n\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 660,
        "y": 150,
        "wires": [
            []
        ]
    },
    {
        "id": "tank_chart",
        "type": "ui_chart",
        "z": "water_hmi_tab",
        "name": "Tank Level History",
        "group": "water_group",
        "order": 2,
        "width": 6,
        "height": 4,
        "label": "Tank Level History",
        "chartType": "line",
        "legend": "false",
        "xformat": "HH:mm:ss",
        "interpolate": "linear",
        "nodata": "",
        "dot": false,
        "ymin": "0",
        "ymax": "100",
        "removeOlder": "1",
        "removeOlderPoints": "",
        "removeOlderUnit": "60",
        "cutout": 0,
        "useOneColor": false,
        "useUTC": false,
        "colors": [
            "#2196F3",
            "#aec7e8",
            "#ff7f0e",
            "#2ca02c",
            "#98df8a",
            "#d62728",
            "#ff9896",
            "#9467bd",
            "#c5b0d5"
        ],
        "outputs": 1,
        "useDifferentColor": false,
        "className": "",
        "x": 660,
        "y": 230,
        "wires": [
            []
        ]
    },
    {
        "id": "openplc_modbus",
        "type": "modbus-client",
        "name": "OpenPLC",
        "clienttype": "tcp",
        "tcpHost": "127.0.0.1",
        "tcpPort": "502",
        "tcpType": "DEFAULT",
        "serialPort": "/dev/ttyUSB",
        "serialType": "RTU-BUFFERD",
        "serialBaudrate": "9600",
        "serialDatabits": "8",
        "serialStopbits": "1",
        "serialParity": "none",
        "serialConnectionDelay": "100",
        "unit_id": "1",
        "commandDelay": "100",
        "clientTimeout": "1000",
        "reconnectOnTimeout": true,
        "reconnectTimeout": "2000",
        "parallelUnitIdsAllowed": true
    },
    {
        "id": "water_group",
        "type": "ui_group",
